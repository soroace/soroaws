# 运行参数（AWS 账号配置见 accounts.json，模板：accounts.json.example）

# Ping 检测总时长，单位秒（可选，默认 15，期间持续 Ping，有任一回复即视为可达）
PING_TIMEOUT=15

# 检测间隔，单位分钟（可选，默认 1）
CHECK_INTERVAL_MIN=1

# 同一账号+区域并行更换 IP 的最大并发数（可选，默认 2，避免触发 AWS 限流）
ROTATE_CONCURRENCY=2

# 退出前等待在途操作完成的最长时间，单位秒（可选，默认 120）
SHUTDOWN_GRACE_SEC=120

# Server酱 推送 Token（可选，留空不推送）
SERVER_CHAN_TOKEN=

# 账号配置文件路径（可选，默认项目根 accounts.json）
# AWS_ACCOUNTS_FILE=./accounts.json
