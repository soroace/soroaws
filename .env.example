# AWS 凭证（必填）
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# AWS 区域（必填，多个用逗号分隔）
AWS_REGIONS=ap-northeast-1, ap-northeast-2, ap-southeast-1

# Ping 检测总时长，单位秒（可选，默认 15，期间持续 Ping，有任一回复即视为可达）
PING_TIMEOUT=15

# 检测间隔，单位分钟（可选，默认 1）
CHECK_INTERVAL_MIN=1

# 同一区域并行更换 IP 的最大并发数（可选，默认 2，避免触发 AWS 限流）
ROTATE_CONCURRENCY=2

# 退出前等待在途操作完成的最长时间，单位秒（可选，默认 120）
SHUTDOWN_GRACE_SEC=120

# Server酱 推送 Token（可选，留空不推送）
SERVER_CHAN_TOKEN=
